# Copy to .env on the host (never commit .env).
# LAN address of the host to serve on; default is loopback only.
AREA_EVENTS_BIND=192.168.1.88
AREA_EVENTS_PORT=8765
AREA_EVENTS_INTERVAL_SECONDS=3600
# Image tag, for rollback: area-events:local, area-events:<git-hash>
AREA_EVENTS_TAG=local
# Management API for multi-area mode. Leave empty to keep it off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into Home Assistant's secrets.yaml as: area_events_authorization: "Bearer <key>"
AREA_EVENTS_API_KEY=
